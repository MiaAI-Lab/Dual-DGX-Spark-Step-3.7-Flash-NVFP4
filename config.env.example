# 2x DGX Spark network config
# Example IPs below. Change these to your own DGX Spark head/worker IPs.
HEAD_IP=169.254.109.196
WORKER_IP=169.254.122.228
# Example DGX Spark interfaces. Change if your system differs.
ETH_IF=enp1s0f1np1
IB_IF=rocep1s0f1,roceP2p1s0f1

# Model/server config
MODEL=stepfun-ai/Step-3.7-Flash-NVFP4
SERVED_MODEL_NAME=stepfun-ai/Step-3.7-Flash-NVFP4
PORT=8888

# Docker
IMAGE=stepfun37-workspace:latest
BASE_IMAGE=vllm/vllm-openai:stepfun37
CONTAINER_NAME=vllm_node

# vLLM
TP_SIZE=2
MAX_MODEL_LEN=262144
MAX_NUM_BATCHED_TOKENS=8192
MAX_NUM_SEQS=8
GPU_MEMORY_UTILIZATION=0.85

# MTP
MTP_NUM_SPECULATIVE_TOKENS=3

# Cluster coordination (no-Ray PyTorch distributed)
MASTER_PORT=29501
